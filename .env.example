# Copie para .env, preencha a senha e mantenha o arquivo fora do Git.
# Na máquina anfitriã, DB_BIND_IP deve ser o IPv4 da rede privada usada pela equipe.
# Nos computadores da equipe, ajuste DB_URL para jdbc:postgresql://IP_DO_ANFITRIAO:5432/ewaste.
DB_NAME=ewaste
DB_USER=ewaste
DB_PASSWORD=
DB_BIND_IP=127.0.0.1
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/ewaste
STORAGE_DIR=./uploads
