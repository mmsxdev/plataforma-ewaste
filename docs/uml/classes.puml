@startuml
!pragma layout smetana
skinparam classAttributeIconSize 0
class Empresa {
  id : Long
  tipo : TipoEmpresa
  cnpj : String
}
class Usuario {
  empresaId : Long
  perfil : PerfilUsuario
  senhaHash : String
}
class Solicitacao {
  id : Long
  geradoraId : Long
  coletoraId : Long
  pontoDescarteId : Long
  status : StatusSolicitacao
  version : Long
}
class SolicitacaoItem {
  identificacao : String
  tipoResiduo : TipoResiduo
  quantidade : int
  pesoKg : BigDecimal
}
enum TipoResiduo {
  INFORMATICA
  TELEFONIA
  ELETRODOMESTICO
  MIDIA_ARMAZENAMENTO
  BATERIA
  OUTRO
}
interface PontosColeta {
  consultar(cidade, tipo)
  buscar(id)
  buscarParaHistorico(id)
  validar(id, tipos)
}
class PontoResumo <<record>>
class PontosColetaService
class PontoColetaRepository
class ArvoreAvl {
  inserir(chave, valor)
  buscar(chave)
  emOrdem()
  altura()
}
class SolicitacaoService {
  criar(nova : Solicitacao) : Long
}
class RastreioService
interface EmissorDocumentos
class DocumentoService
Empresa "0..1" -- "0..*" Usuario : empresaId
Empresa "1" -- "0..*" Solicitacao : geradoraId
Solicitacao "1" *-- "0..*" SolicitacaoItem
SolicitacaoItem --> TipoResiduo
SolicitacaoService --> PontosColeta
PontosColetaService ..|> PontosColeta
PontosColetaService --> PontoColetaRepository
PontosColetaService --> ArvoreAvl : constrói por consulta
ArvoreAvl --> PontoResumo : valores
RastreioService --> EmissorDocumentos
DocumentoService ..|> EmissorDocumentos
note right of Usuario
ADMIN: empresaId nullable.
Demais perfis são vinculados à empresa.
end note
note bottom of Solicitacao
Associações entre módulos por ID,
sem entidades JPA cruzadas.
PontoResumo é projeção JDBC, não entidade JPA.
end note
package "Homologação e alerta retroativo" {
  class Homologacao {
    empresaId : Long
    status : StatusHomologacao
    enviarParaAnalise()
    aprovar(adminId)
    reprovar(adminId, motivo)
  }
  class DocumentoHomologacao {
    tipo : TipoDocumentoHomologacao
    arquivoRef : String
    validade : LocalDate
  }
  class HomologacaoColetoraController
  class AdminHomologacaoController
  class HomologacaoService {
    enviarDocumento(coletoraId, tipo, validade, arquivo)
    enviarParaAnalise(coletoraId)
    aprovar(homologacaoId, adminId)
    reprovar(homologacaoId, adminId, motivo)
  }
  interface ColetorasAptas {
    listarAptas()
  }
  enum StatusHomologacao {
    PENDENTE
    EM_ANALISE
    APROVADA
    REPROVADA
    SUSPENSA
  }
  interface EmpresaConsulta {
    buscar(id)
  }
  class ColetorasAptasService
  class ColetoraHomologadaEvent <<record>> {
    coletoraId : Long
  }
  class AlertaAoHomologar {
    aoHomologar(evento)
  }
  interface SolicitacaoConsulta {
    listarAbertas()
  }
  class AlertaSolicitacaoRepository
  class AlertaSolicitacao {
    solicitacaoId : Long
    coletoraId : Long
    distanciaKm : BigDecimal
  }
  class AlertasEnviadosEvent <<record>>
  Homologacao "1" *-- "0..*" DocumentoHomologacao
  HomologacaoColetoraController --> HomologacaoService
  AdminHomologacaoController --> HomologacaoService
  HomologacaoService --> Homologacao
  HomologacaoService ..> ColetoraHomologadaEvent : publica na aprovação
  ColetorasAptasService ..|> ColetorasAptas
  ColetoraHomologadaEvent ..> AlertaAoHomologar : AFTER_COMMIT / REQUIRES_NEW
  AlertaAoHomologar --> EmpresaConsulta
  AlertaAoHomologar --> ColetorasAptas
  AlertaAoHomologar --> SolicitacaoConsulta
  AlertaAoHomologar --> AlertaSolicitacaoRepository
  AlertaSolicitacaoRepository --> AlertaSolicitacao
  AlertaAoHomologar ..> AlertasEnviadosEvent : publica após gravar
}
Empresa "1" -- "0..1" Homologacao : empresaId
note bottom of AlertaAoHomologar
Só solicitações ABERTAS no raio, com coletora apta.
Referências entre módulos são IDs/APIs, sem JPA cruzada.
Suspender não possui ação na interface atual.
end note
@enduml
