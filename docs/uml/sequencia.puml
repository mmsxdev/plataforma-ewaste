@startuml
!pragma layout smetana
title Consulta de pontos e criação de solicitação
actor Geradora
boundary "PontosColetaController" as WebP
control "PontosColetaService" as Pontos
entity "PontoColetaRepository" as Repo
collections "ArvoreAvl" as AVL
boundary "SolicitacaoController" as WebS
control "SolicitacaoService" as Sol
database PostgreSQL as DB
Geradora -> WebP : GET /mapa?cidade=...&tipo=...
WebP -> Pontos : consultar(cidade, tipo)
Pontos -> Repo : listarAtivos()
Repo -> DB : SELECT ponto_descarte
DB --> Repo : registros
Repo --> Pontos : pontos ativos
loop cada registro
  Pontos -> AVL : inserir(id, ponto)
end
Pontos -> AVL : emOrdem()
AVL --> Pontos : pontos ordenados
Pontos --> WebP : lista filtrada
WebP --> Geradora : ponto e ação de solicitar
Geradora -> WebS : GET nova?pontoDescarteId=...&tipoResiduo=...
WebS --> Geradora : formulário com ponto/categoria
Geradora -> WebS : POST identificação/itens/ponto
WebS -> Sol : criar(dados, empresa autenticada)
Sol -> Pontos : validar(ponto, tipos)
Pontos -> Repo : compatibilidade pela Function SQL
Repo -> DB : ponto_aceita_tipo(id, tipo)
alt dados e ponto válidos
  Sol -> DB : transação INSERT solicitacao + itens
  Sol -> Sol : publicar evento dentro da transação
  DB --> Sol : commit pela fronteira transacional
  Sol -> Sol : listeners AFTER_COMMIT de criação/roteamento
  Sol --> WebS : solicitação criada
  WebS --> Geradora : redirecionar ao detalhe/histórico
else incompatível/inativo/inválido
  Sol --> WebS : erro de negócio / rollback
  WebS --> Geradora : mensagem sem gravação parcial
end
note over Pontos, AVL
Também buscar(id) consulta árvore reconstruída
a partir do banco; sem cache global.
end note
@enduml
